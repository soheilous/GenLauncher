{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenLauncher",
  "version": "0.1.10",
  "identifier": "com.genlauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "GenLauncher",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "GenLauncher",
    "copyright": "Copyright (c) 2026 soheilous and GenLauncher contributors. MIT License.",
    "category": "Game",
    "shortDescription": "A mod launcher for Command & Conquer: Generals and Zero Hour",
    "longDescription": "Install, switch between and start mods, patches, add-ons and executables for Command & Conquer: Generals and Zero Hour. Your game folder is restored when the game closes.",
    "license": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0MDQ1REVBQjZBMjYwN0YKUldSL1lLSzI2bDBFeEo3ODBneCticHpNdWY5Qk9yUDBhVzVrUHEvNzBFTmtXaDNzYml0Wk4wQk8K",
      "endpoints": [
        "https://github.com/soheilous/GenLauncher/releases/download/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
